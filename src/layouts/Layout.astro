---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HAUSS — Dieseño y construcción",
  description = "Obras nuevas y remodelaciones llave en mano en Puerto Montt, Chile.",
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
