# Resend (https://resend.com) — used by src/pages/api/contacto.ts to send
# the contact form email. Copy this file to .env for local dev with
# `astro dev`. In Cloudflare Pages, set these as environment
# variables/secrets on the project instead (they're read from the
# `cloudflare:workers` runtime module there, not from this file).
RESEND_API_KEY=
# Address that receives contact form submissions.
CONTACT_TO_EMAIL=contacto@hauss.cl
# Sender address — must be on a domain verified in Resend. Resend's sandbox
# sender onboarding@resend.dev works for local testing without a verified
# domain, but only delivers to the email tied to your Resend account.
CONTACT_FROM_EMAIL=onboarding@resend.dev
